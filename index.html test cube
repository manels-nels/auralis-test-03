<!DOCTYPE html>
<html>
<head>
<title>Simple AR Cube Test</title>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<style>
body { margin: 0; overflow: hidden; }
</style>
</head>
<body>
<a-scene embedded arjs="sourceType: webcam; trackingMethod: best;">
<a-box color="red"
position="0 0 -5"
scale="1 1 1"
class="clickable"
clickable-cube>
</a-box>
<a-camera
        position="0 0 0"
        cursor="rayOrigin: mouse; fuse: false; objects: .clickable"
        raycaster="objects: .clickable;">
    </a-camera>
</a-scene>

<script src="https://aframe.io/releases/1.3.0/aframe.min.js"></script>
<script src="https://cdn.jsdelivr.net/gh/AR-js-org/AR.js@3.4.0/aframe/build/aframe-ar.min.js"></script>
<script>
    AFRAME.registerComponent('clickable-cube', {
        init: function () {
            const el = this.el;
            const colors = ['red', 'green', 'blue'];
            let colorIndex = 0;

            el.addEventListener('mousedown', function () {
                colorIndex = (colorIndex + 1) % colors.length;
                el.setAttribute('material', 'color', colors [colorIndex]);
                console.log('Cube touched, color changed to:', colors [colorIndex]);
            });
        }
    });
</script>

</body>
</html>
